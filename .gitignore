# ============================================================
# .gitignore — YouzinCrabz Tunnel
# ============================================================

# ── Secrets & Credentials ──
.env
*.env
.env.*
.bot_token
.chat_id
.join_secret
.master_ip
.svc_reg
.payment_info
**/credentials.json
**/secret*.key
*.pem
*.crt
*.key

# ── Database ──
*.sql.bak
*.sql.gz
*.db
*.sqlite
*.sqlite3

# ── Config files (auto-generated) ──
config.json
xray_config.json
*.conf.local

# ── Logs ──
*.log
/logs/
/var/log/

# ── Backup files ──
*.bak
*.backup
*.old
*.orig
*~

# ── OS / Editor ──
.DS_Store
Thumbs.db
*.swp
*.swo
*.swn
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Compiled / Binary ──
*.o
*.so
*.bin
# shc compiled output (keep source, ignore binary)
*.x

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# ── Node (if any) ──
node_modules/
npm-debug.log*
yarn-error.log*

# ── Cache ──
.cache/
*.cache
.tmp/
tmp/

# ── Upload directory ──
uploads/
*.upload

# ── System / runtime files (auto-generated by the VPN binary) ──
.ip_vps
.sysinfo_cache
.xray_config.lock
.ddos_rules
traffic/
akun/
orders/
